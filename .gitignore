# Build output
/target/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# Maven wrapper: ignore stray jars, keep the wrapper itself
*.jar
!.mvn/wrapper/maven-wrapper.jar

# IDEs
.idea/
*.iws
*.iml
*.ipr
.vscode/

# STS / Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Local uploads (profile-driven; do not commit user content)
/uploads/
/uploads-local/

# OS cruft
.DS_Store
Thumbs.db

# Spring Initializr scaffolding
HELP.md

# Secrets: never commit a local override of application.properties
application-local-override.properties
*.env

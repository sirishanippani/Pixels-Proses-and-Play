      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Figure 7.1 — Deployment Topology" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;fontFamily=Times New Roman" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- Client zone -->
        <mxCell id="client-zone" value="Public Internet" style="rounded=0;html=1;fillColor=none;strokeColor=#333333;dashed=1;verticalAlign=top;fontFamily=Times New Roman;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="260" height="620" as="geometry" />
        </mxCell>

        <mxCell id="browser" value="Web Browser&#10;(reader / author)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Times New Roman;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="100" y="140" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="dns" value="DNS&#10;pixels-proses-and-play&#10;.onrender.com" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Times New Roman;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="100" y="250" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="uptime" value="UptimeRobot&#10;prober&#10;(every 5 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Times New Roman;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="100" y="560" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- Render zone -->
        <mxCell id="render-zone" value="Render (application runtime)" style="rounded=0;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=0;verticalAlign=top;fontFamily=Times New Roman;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="370" y="90" width="480" height="620" as="geometry" />
        </mxCell>

        <mxCell id="edge" value="Render Edge&#10;TLS termination + managed cert&#10;Reverse proxy to container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="410" y="140" width="400" height="80" as="geometry" />
        </mxCell>

        <mxCell id="container" value="&lt;b&gt;Container (free tier)&lt;/b&gt;&lt;hr/&gt;eclipse-temurin:17-jre-jammy&lt;br/&gt;java -XX:MaxRAMPercentage=75.0 -jar app.jar&lt;br/&gt;Spring Boot on port ${PORT}&lt;br/&gt;Non-root user ‘app’&lt;br/&gt;Graceful shutdown (25s drain)&lt;br/&gt;Scale-to-zero after 15 min idle" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=11;align=left;spacingLeft=8;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="410" y="260" width="400" height="160" as="geometry" />
        </mxCell>

        <mxCell id="actuator" value="/actuator/health&#10;(anonymous)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Times New Roman;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="610" y="450" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="envstore" value="Env-var store&#10;(encrypted)&#10;DATABASE_URL, USERNAME, PASSWORD&#10;ADMIN_USERNAME, EMAIL, PASSWORD&#10;SPRING_PROFILES_ACTIVE, PORT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Times New Roman;fontSize=10;align=left;spacingLeft=8;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="410" y="520" width="400" height="120" as="geometry" />
        </mxCell>

        <!-- Neon zone -->
        <mxCell id="neon-zone" value="Neon (managed PostgreSQL)" style="rounded=0;html=1;fillColor=none;strokeColor=#b85450;dashed=0;verticalAlign=top;fontFamily=Times New Roman;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="900" y="90" width="350" height="620" as="geometry" />
        </mxCell>

        <mxCell id="pooler" value="Pooler endpoint&#10;(PgBouncer, transaction mode)&#10;TLS required&#10;prepareThreshold=0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Times New Roman;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="940" y="200" width="270" height="100" as="geometry" />
        </mxCell>

        <mxCell id="pg" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;hr/&gt;Flyway-managed schema&lt;br/&gt;Scale-to-zero after 5 min idle&lt;br/&gt;Free-tier storage" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Times New Roman;fontSize=11;align=left;spacingLeft=14;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="950" y="380" width="250" height="180" as="geometry" />
        </mxCell>

        <!-- Arrows -->
        <mxCell id="a-browser-dns" value="1. DNS lookup" style="endArrow=classic;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=10" edge="1" parent="1" source="browser" target="dns"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-browser-edge" value="2. HTTPS request" style="endArrow=classic;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=10" edge="1" parent="1" source="browser" target="edge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-edge-container" value="3. Plaintext HTTP&#10;to ${PORT}" style="endArrow=classic;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=10" edge="1" parent="1" source="edge" target="container"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-container-pooler" value="4. JDBC / HikariCP&#10;(TLS)" style="endArrow=classic;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=10" edge="1" parent="1" source="container" target="pooler"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-pooler-pg" value="5. SQL" style="endArrow=classic;html=1;strokeColor=#000000;fontFamily=Times New Roman;fontSize=10" edge="1" parent="1" source="pooler" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-envstore-container" value="injects at boot" style="endArrow=classic;html=1;strokeColor=#d6b656;dashed=1;fontFamily=Times New Roman;fontSize=10;fontStyle=2" edge="1" parent="1" source="envstore" target="container"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-uptime-actuator" value="GET /actuator/health&#10;every 5 min" style="endArrow=classic;html=1;strokeColor=#9673a6;fontFamily=Times New Roman;fontSize=10" edge="1" parent="1" source="uptime" target="edge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-edge-actuator" value="forwarded" style="endArrow=classic;html=1;strokeColor=#9673a6;dashed=1;fontFamily=Times New Roman;fontSize=10;fontStyle=2" edge="1" parent="1" source="edge" target="actuator"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Black arrows — user request path.  Purple arrows — uptime-prober path.  Yellow dashed arrow — environment-variable injection at container start.&#10;Zones: grey — public internet. Blue — Render. Red — Neon. (The container cannot be reached from the public internet directly; all ingress is through Render's edge.)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontFamily=Times New Roman;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="60" y="730" width="1200" height="50" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

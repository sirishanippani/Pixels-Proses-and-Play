        <!-- Legend -->
        <mxCell id="legend" value="Notation:  Filled diamond — composition (lifecycle owned by source).  Plain line — association.  Multiplicities read source-end  .. target-end." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontFamily=Times New Roman;fontStyle=2" vertex="1" parent="1">

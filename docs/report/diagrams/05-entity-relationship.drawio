        <!-- Legend -->
        <mxCell id="legend" value="Notation:  Crow's-foot cardinality marks at each relationship end.  ERone (single bar) — exactly one.  ERmany (crow's foot) — zero or more.&#10;Beige tables are domain entities.  Yellow table is an associative (join) table.  Grey table is the Flyway-managed migration-history metadata table (not part of the application schema)." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontFamily=Times New Roman;fontStyle=2" vertex="1" parent="1">
